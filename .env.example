# Copy to `.env` and fill in real values. Never commit the filled-in file --
# `.env` is gitignored.

# --- Database -------------------------------------------------------------
# Postgres connection string, e.g. a Neon pooled URL. When unset the backend
# falls back to a local SQLite file at movie-backend/data/freestream.db.
DATABASE_URL=

# --- Movie metadata API ---------------------------------------------------
# Required for TMDB lookups. Get one at https://www.themoviedmdb.org/settings/api
# If this is empty the backend still serves auth and the local catalog; only
# live TMDB lookups are skipped, and it logs a warning at startup.
TMDB_API_KEY=

# Optional: OMDb enrichment and fallback, read by catalog_service.py.
OMDB_API_KEY=

# Optional: Trakt breadth list, read by catalog_service.py. Skipped if empty.
TRAKT_CLIENT_ID=

# --- Operator access -------------------------------------------------------
# Comma-separated email addresses allowed to read `/admin/users`, the read-only
# account roster. A request is authorized against this list on every call, using
# the address on the token's own user row -- never a query parameter, a header,
# or anything else the client sent.
#
# EMPTY OR UNSET DENIES EVERYONE, and that is deliberate. A permissive default
# would hand every account's email, join date and activity counts to anyone who
# can register an account, which is the single thing this list exists to prevent.
# An unset value is therefore the safe failure, not a broken one: `/admin/users`
# answers 403 and nothing else changes.
#
# Matching is exact and case-insensitive. There is no wildcard form on purpose:
# an entry like `*@example.com` authorises whoever registers that domain, and a
# domain can change hands.
#
# This grants read access to the roster and nothing else. It is not a role: it
# does not unlock catalogue editing or any other capability, because there is no
# catalogue-correction surface (see docs/prd.md).
ADMIN_EMAILS=

# --- Frontend -------------------------------------------------------------
# Local dev: leave EMPTY. Vite proxies /api to the Flask process on :5000, so
# every request stays same-origin.
#
# Vercel: the deployed SPA hosts no API of its own, so a relative /api call
# resolves against Vercel and returns the SPA shell instead of JSON, which
# renders as an empty catalogue. Set this to the public URL of the deployed
# Flask backend (the Render service) and the browser calls it cross-origin.
#
# Cross-origin is NOT free: Flask reflects Access-Control-Allow-Origin only for
# origins on its allowlist (ALLOWED_ORIGINS below), and sends no CORS headers at
# all otherwise. If you point this at a backend whose allowlist lacks the
# frontend's domain, every request fails with "No 'Access-Control-Allow-Origin'
# header" and an empty catalogue -- so a domain change here usually needs a
# matching change to ALLOWED_ORIGINS and a backend redeploy.
#
# If this is missing OR blank, production builds fall back to the hardcoded
# Render origin in client/src/services/api.ts, and the console logs a warning
# saying so. Set it anyway: the fallback is a reclaimable *.onrender.com
# subdomain, so deleting the Render project frees the name for someone else to
# register, after which users' auth tokens would be POSTed to whoever answers.
# A custom domain on the backend removes that exposure.
#
# VITE_ variables are inlined by Vite at BUILD time, so this has to be set in
# the Vercel project env vars and the project redeployed to take effect. Set it
# under the scope matching the deployment: Preview builds do not read
# Production values. Set it to "/" to deliberately ship same-origin.
#
# Note: an absolute URL here sends users' Authorization: Bearer tokens to that
# host. Only point it at a backend you control.
VITE_MOVIE_API_BASE_URL=

# --- Phased Next.js VOD app -----------------------------------------------
# See docs/next-vod.md for the catalog schema. Use a high-entropy secret
# (32+ characters), exact HTTPS media origins, and catalog entries whose
# ownership or distribution rights have been verified.
VOD_PROXY_SECRET=
VOD_ALLOWED_ORIGINS=
VOD_CATALOG_JSON=

# --- Playback provider chain ---------------------------------------------
# Comma-separated provider ids defining playback priority. Ids absent from the
# built-in manifest are ignored; manifest providers left unnamed keep their
# default relative order.
STREAM_PROVIDER_ORDER=

# Comma-separated provider ids to remove entirely. Setting this to the direct
# tier's providers leaves the app with no Archive.org playback at all.
STREAM_PROVIDER_DISABLED=

# --- CORS -----------------------------------------------------------------
# Exact-match allow-list. No wildcard: every unrelated project on a shared
# domain owns a hostname there, so a wildcard would let any of them act as a
# signed-in user. Requests with no Origin header (the Express wrapper's
# server-to-server call) are unaffected.
#
# Must contain the frontend's origin exactly. The frontend has moved once
# already (vy-virid.vercel.app -> streamvy.vercel.app) and the failure was
# silent: the catalogue came up empty and login stopped working, because a CORS
# rejection looks identical to a dead backend at the call site. When the
# frontend domain changes, update this, then redeploy. The defaults live in
# `_DEFAULT_ALLOWED_ORIGINS` in movie-backend/app.py.
#
# Vercel preview deploys get unique *.vercel.app hostnames and are NOT covered
# by an exact match. Either list each one, or proxy the API through the Vercel
# deployment (vercel.json) so the browser sees a same-origin request.
ALLOWED_ORIGINS=

# --- Backend store --------------------------------------------------------
# SQLite file used when DATABASE_URL is unset.
SQLITE_PATH=

# Optional: OAuth server URL (template framework plumbing, not product auth).
OAUTH_SERVER_URL=

# --- Venice AI (optional) --------------------------------------------------
# Privacy-preserving AI gateway that is OpenAI-compatible, so any OpenAI-style
# client works by pointing it at the base URL instead of api.openai.com.
# Get a key at https://venice.ai. Read by server/_core/venice.ts.
# If this is empty, Venice-backed features are unavailable and throw on use;
# nothing else in the app depends on it.
VENICE_API_KEY=
# Optional: override the API base URL (e.g. a proxy). Must include the /v1 path.
# VENICE_API_BASE_URL=https://api.venice.ai/api/v1
# Optional: default model, used when a call does not pass one explicitly.
# VENICE_MODEL=zai-org-glm-5-2

# --- Local development (optional) -----------------------------------------
# Set to 1 to enable the Flask debugger. It then binds to 127.0.0.1 only.
# FLASK_DEBUG=0
# Where the Express server looks for the Flask backend.
# FLASK_URL=http://127.0.0.1:5000
# Set to 1 to skip loading .env files and use the real environment only.
# LENIUM_SKIP_ENV_FILE=0
